# Vite 로컬 개발과 Cloudflare 웹은 비워 두면 같은 Origin의 /api를 사용합니다.
# 앱인토스 .ait 번들은 배포된 Worker의 HTTPS 주소를 설정하고 다시 빌드합니다.
# 예: VITE_API_BASE_URL=https://mythos.<실제-subdomain>.workers.dev
# 여기는 공개 API 주소만 넣고 비밀값은 넣지 않습니다.
VITE_API_BASE_URL=

# 앱인토스 콘솔에서 발급한 배너 광고 그룹 ID. 비우면 테스트 ID(ait-ad-test-banner-id)를 쓴다.
# 실제 ID로 테스트하면 정책 위반이 될 수 있으므로 출시 빌드에만 넣는다.
VITE_TOSS_BANNER_AD_GROUP_ID=
